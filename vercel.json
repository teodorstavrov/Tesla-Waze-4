{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": {
      "memory": 256,
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync-stations",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/cron/sync-stations?heal=1",
      "schedule": "30 3 * * 1-6"
    },
    {
      "path": "/api/cron/sync-cameras?country=BG",
      "schedule": "0 4 * * 0"
    },
    {
      "path": "/api/cron/event-reminders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/sync-cameras?country=SE-1",
      "schedule": "20 5 * * 0"
    },
    {
      "path": "/api/cron/sync-cameras?country=SE-2",
      "schedule": "25 5 * * 0"
    },
    {
      "path": "/api/cron/sync-cameras?country=SE-3",
      "schedule": "30 5 * * 0"
    },
    {
      "path": "/api/cron/sync-cameras?country=SE-4",
      "schedule": "35 5 * * 0"
    },
    {
      "path": "/api/cron/sync-cameras?country=SE-5",
      "schedule": "40 5 * * 0"
    },
    {
      "path": "/api/cron/sync-cameras?country=FI-1",
      "schedule": "45 5 * * 0"
    },
    {
      "path": "/api/cron/sync-cameras?country=FI-2",
      "schedule": "50 5 * * 0"
    },
    {
      "path": "/api/cron/sync-cameras?country=FI-3",
      "schedule": "55 5 * * 0"
    },
    {
      "path": "/api/cron/sync-cameras?country=NL-1",
      "schedule": "0 6 * * 0"
    },
    {
      "path": "/api/cron/sync-cameras?country=NL-2A",
      "schedule": "5 6 * * 0"
    },
    {
      "path": "/api/cron/sync-cameras?country=NL-2B",
      "schedule": "10 6 * * 0"
    },
    {
      "path": "/api/cron/sync-cameras?country=NL-2C",
      "schedule": "15 6 * * 0"
    },
    {
      "path": "/api/cron/sync-cameras?country=NL-3",
      "schedule": "20 6 * * 0"
    },
    {
      "path": "/api/cron/sync-cameras?country=BE-S",
      "schedule": "25 6 * * 0"
    },
    {
      "path": "/api/cron/sync-cameras?country=BE-N",
      "schedule": "30 6 * * 0"
    },
    {
      "path": "/api/cron/sync-cameras?country=DE-1",
      "schedule": "35 6 * * 0"
    },
    {
      "path": "/api/cron/sync-cameras?country=DE-2",
      "schedule": "40 6 * * 0"
    },
    {
      "path": "/api/cron/sync-cameras?country=DE-3",
      "schedule": "45 6 * * 0"
    },
    {
      "path": "/api/cron/sync-cameras?country=DE-4",
      "schedule": "50 6 * * 0"
    },
    {
      "path": "/api/cron/sync-cameras?country=FR-1",
      "schedule": "55 6 * * 0"
    },
    {
      "path": "/api/cron/sync-cameras?country=FR-2",
      "schedule": "3 7 * * 0"
    },
    {
      "path": "/api/cron/sync-cameras?country=FR-3",
      "schedule": "8 7 * * 0"
    },
    {
      "path": "/api/cron/sync-cameras?country=FR-4",
      "schedule": "13 7 * * 0"
    }
  ],
  "rewrites": [
    { "source": "/admin",          "destination": "/admin.html" },
    { "source": "/engine-builder", "destination": "/engine-builder.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",       "value": "nosniff" },
        { "key": "X-Frame-Options",              "value": "DENY" },
        { "key": "Referrer-Policy",              "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",           "value": "camera=(), microphone=(self), payment=()" },
        { "key": "Strict-Transport-Security",    "value": "max-age=31536000; includeSubDomains" },
        { "key": "Content-Security-Policy",      "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https:; font-src 'self' data:; worker-src 'self' blob:;" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
